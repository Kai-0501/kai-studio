{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["ideas"],
  "properties": {
    "ideas": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/idea" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 40 },
    "list": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 20 } },
    "score": { "type": "object", "additionalProperties": false, "required": ["score", "rationale"], "properties": { "score": { "type": "integer", "minimum": 1, "maximum": 10 }, "rationale": { "$ref": "#/$defs/text" } } },
    "idea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "problem", "targetUser", "distinctiveness", "qualityGate", "mvp", "smallestExperiment", "architectureDecisions", "repositoryPlan", "dataModel", "contracts", "stateMachines", "aiRuntime", "implementationPhases", "deliverables", "acceptanceCriteria", "tests", "securityAndPrivacy", "failureRecovery", "risks", "assumptions", "nonGoals"],
      "properties": {
        "title": { "type": "string", "minLength": 8, "maxLength": 90 },
        "summary": { "type": "string", "minLength": 80, "maxLength": 600 },
        "problem": { "$ref": "#/$defs/text" },
        "targetUser": { "$ref": "#/$defs/text" },
        "distinctiveness": { "type": "object", "additionalProperties": false, "required": ["existingAlternatives", "materialDifference", "repositoryOverlapCheck"], "properties": { "existingAlternatives": { "$ref": "#/$defs/list" }, "materialDifference": { "$ref": "#/$defs/text" }, "repositoryOverlapCheck": { "$ref": "#/$defs/text" } } },
        "qualityGate": { "type": "object", "additionalProperties": false, "required": ["productValue", "distinctiveness", "repeatUsage", "feasibility", "portfolioValue"], "properties": { "productValue": { "$ref": "#/$defs/score" }, "distinctiveness": { "$ref": "#/$defs/score" }, "repeatUsage": { "$ref": "#/$defs/score" }, "feasibility": { "$ref": "#/$defs/score" }, "portfolioValue": { "$ref": "#/$defs/score" } } },
        "mvp": { "type": "object", "additionalProperties": false, "required": ["scope", "referenceScenario", "successDefinition"], "properties": { "scope": { "$ref": "#/$defs/text" }, "referenceScenario": { "$ref": "#/$defs/text" }, "successDefinition": { "$ref": "#/$defs/text" } } },
        "smallestExperiment": { "type": "object", "additionalProperties": false, "required": ["hypothesis", "method", "successThreshold", "failureThreshold", "timebox"], "properties": { "hypothesis": { "$ref": "#/$defs/text" }, "method": { "$ref": "#/$defs/text" }, "successThreshold": { "$ref": "#/$defs/text" }, "failureThreshold": { "$ref": "#/$defs/text" }, "timebox": { "type": "string", "minLength": 8 } } },
        "architectureDecisions": { "type": "object", "additionalProperties": false, "required": ["frontend", "backend", "persistence", "files", "backgroundWork", "integrations", "deployment", "recovery"], "properties": { "frontend": { "$ref": "#/$defs/text" }, "backend": { "$ref": "#/$defs/text" }, "persistence": { "$ref": "#/$defs/text" }, "files": { "$ref": "#/$defs/text" }, "backgroundWork": { "$ref": "#/$defs/text" }, "integrations": { "$ref": "#/$defs/text" }, "deployment": { "$ref": "#/$defs/text" }, "recovery": { "$ref": "#/$defs/text" } } },
        "repositoryPlan": { "type": "object", "additionalProperties": false, "required": ["tree", "principalFiles"], "properties": { "tree": { "$ref": "#/$defs/list" }, "principalFiles": { "type": "array", "minItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["path", "responsibility"], "properties": { "path": { "type": "string", "minLength": 3 }, "responsibility": { "$ref": "#/$defs/text" } } } } } },
        "dataModel": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["name", "purpose", "fields", "relationships", "constraints", "versioning"], "properties": { "name": { "type": "string", "minLength": 3 }, "purpose": { "$ref": "#/$defs/text" }, "fields": { "$ref": "#/$defs/list" }, "relationships": { "$ref": "#/$defs/list" }, "constraints": { "$ref": "#/$defs/list" }, "versioning": { "$ref": "#/$defs/text" } } } },
        "contracts": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["name", "transport", "input", "output", "validation", "errors", "timeoutRetry", "idempotency"], "properties": { "name": { "type": "string", "minLength": 5 }, "transport": { "type": "string", "minLength": 8 }, "input": { "$ref": "#/$defs/text" }, "output": { "$ref": "#/$defs/text" }, "validation": { "$ref": "#/$defs/text" }, "errors": { "$ref": "#/$defs/text" }, "timeoutRetry": { "$ref": "#/$defs/text" }, "idempotency": { "$ref": "#/$defs/text" } } } },
        "stateMachines": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "states", "transitions", "cancellation", "recovery"], "properties": { "name": { "type": "string", "minLength": 5 }, "states": { "$ref": "#/$defs/list" }, "transitions": { "$ref": "#/$defs/list" }, "cancellation": { "$ref": "#/$defs/text" }, "recovery": { "$ref": "#/$defs/text" } } } },
        "aiRuntime": { "type": "object", "additionalProperties": false, "required": ["required", "runtime", "model", "promptContract", "outputContract", "hardwareBudget", "latencyBudget", "fallback", "grounding"], "properties": { "required": { "type": "boolean" }, "runtime": { "type": "string", "minLength": 8 }, "model": { "type": "string", "minLength": 3 }, "promptContract": { "$ref": "#/$defs/text" }, "outputContract": { "$ref": "#/$defs/text" }, "hardwareBudget": { "$ref": "#/$defs/text" }, "latencyBudget": { "$ref": "#/$defs/text" }, "fallback": { "$ref": "#/$defs/text" }, "grounding": { "$ref": "#/$defs/text" } } },
        "implementationPhases": { "type": "array", "minItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["name", "goal", "changes", "workingResult", "verification", "exitCriteria"], "properties": { "name": { "type": "string", "minLength": 5 }, "goal": { "$ref": "#/$defs/text" }, "changes": { "$ref": "#/$defs/list" }, "workingResult": { "$ref": "#/$defs/text" }, "verification": { "$ref": "#/$defs/list" }, "exitCriteria": { "$ref": "#/$defs/text" } } } },
        "deliverables": { "$ref": "#/$defs/list" },
        "acceptanceCriteria": { "type": "array", "minItems": 6, "items": { "type": "object", "additionalProperties": false, "required": ["id", "given", "when", "then", "metric", "threshold", "verification"], "properties": { "id": { "type": "string", "minLength": 3 }, "given": { "$ref": "#/$defs/text" }, "when": { "$ref": "#/$defs/text" }, "then": { "$ref": "#/$defs/text" }, "metric": { "$ref": "#/$defs/text" }, "threshold": { "$ref": "#/$defs/text" }, "verification": { "$ref": "#/$defs/text" } } } },
        "tests": { "type": "array", "minItems": 6, "items": { "type": "object", "additionalProperties": false, "required": ["level", "name", "fixture", "procedure", "expectedResult"], "properties": { "level": { "type": "string", "enum": ["unit", "integration", "end-to-end", "security", "recovery", "performance"] }, "name": { "type": "string", "minLength": 10 }, "fixture": { "$ref": "#/$defs/text" }, "procedure": { "$ref": "#/$defs/text" }, "expectedResult": { "$ref": "#/$defs/text" } } } },
        "securityAndPrivacy": { "$ref": "#/$defs/list" }, "failureRecovery": { "$ref": "#/$defs/list" }, "risks": { "$ref": "#/$defs/list" }, "assumptions": { "$ref": "#/$defs/list" }, "nonGoals": { "$ref": "#/$defs/list" }
      }
    }
  }
}
